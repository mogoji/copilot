# 复制本文件为 .env 并填入真实值；.env 已被 git 忽略，不会提交进仓库。
# app/config.py 会在启动时读取并校验，缺失必需项会立即报错（fail-fast）。

# ===== 必需 =====
# 上游大模型 API 密钥
GLM_API_KEY=

# 数据库连接：二选一
#   方式 A：完整连接串（优先级最高）
# DATABASE_URL=postgresql://copilot:copilot123@localhost:5432/copilot
#   方式 B：分量形式（host/port/dbname/user 有默认值，密码必填）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=copilot
DB_USER=copilot
DB_PASSWORD=copilot123

# ===== 可选覆盖（以下均有默认值，通常无需修改）=====
# GLM_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
# EMB_URL=https://open.bigmodel.cn/api/paas/v4/embeddings
# GLM_MODEL=glm-5.3-flash
# EMBEDDING_MODEL=embedding-3
# EMBEDDING_DIMENSIONS=1024
# EVIDENCE_TH=0.60
# HTTP_TIMEOUT=60
# EMBED_TIMEOUT=30
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== JWT（登录令牌）=====
# 生产环境务必改为随机强密钥；未设置时会用开发默认值并打印告警。
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
# JWT_ALGORITHM=HS256
# 令牌有效期（分钟），默认 1440 = 24 小时
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
